# =============================================================================
# Oral History Archive - Environment Example Configuration
# =============================================================================
# Configuration is loaded from environment variables. In development,
# pydantic-settings ALSO reads this ./.env file. Outside dev the file is not
# read by pydantic — configuration must arrive as real OS environment
# variables. Deployed units load /etc/oralhistarchiv/common.env plus their
# web.env or scheduler.env overlay; migration loads migration.env separately.
# These files are root-owned 0600. OS variables override .env.
# This file is also the annotated reference for every setting.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------

# Environment
# NOTE: Outside dev, ENV_STATE must be a real OS environment variable (the
# systemd unit's EnvironmentFile= provides it). The app reads ENV_STATE from
# the OS environment BEFORE parsing to decide whether to also load ./.env, and
# refuses to boot if a non-dev ENV_STATE is seen only from a .env file — so a
# non-dev value can never be smuggled in through the dotenv itself.
ENV_STATE="dev"

# External origin for links; no credentials/path/query/fragment. Hardened modes
# require HTTPS and a non-localhost host matching ALLOWED_HOSTS.
PUBLIC_BASE_URL="http://127.0.0.1:5000"

# Operator contact — shown in templates (About page mailto) and quoted in
# security-notification emails (verification, lockout, reset notices).
CONTACT_EMAIL="archive@example.uzh.ch"

# Datasets per page on list/search views (1-100).
PAGINATION_SIZE=20

# Determines if mock data be seeded into the database. Allowed in Dev and staging 
# for presentation purposes. MUST be false in production.
SEED_MOCK_DATA="false"
# -----------------------------------------------------------------------------
# FastAPI Settings
# -----------------------------------------------------------------------------

# Host and port for the FastAPI development server
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT=5000 
FASTAPI_DEBUG=true # Enable/disable debug mode (never enable in production!)

# -----------------------------------------------------------------------------
# API URLs
# -----------------------------------------------------------------------------

# Example development catalogue: Kassel records live on the SWISSUbase demo
# endpoint. Select the real endpoint and a matching institution for production.
SWISSUBASE_OAI_PMH_URL="https://demo.swissubase.ch/oai-pmh/v1/oai"

# OAI-PMH sync configuration
# Change to match your registered institution name in SWISSUbase
OAI_INSTITUTION_FILTER="Universität Kassel"

# Scheduler cadence (seconds): incremental harvest interval, and the interval
# for the periodic full rebuild of Source A.
SYNC_INTERVAL_SECONDS=3600
FULL_REBUILD_INTERVAL_SECONDS=86400

# Maximum time in seconds for one sync persistence phase (1..3600).
SYNC_WRITE_TIMEOUT_SECONDS=120

# Safety cap on OAI-PMH resumption-token pagination — stops a harvest if the
# upstream returns more pages than this. Set well above your expected
# record count divided by page size.
OAI_MAX_PAGES=500

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Development only. Production removes DATABASE_URL from common.env and uses
# root-owned web.env/scheduler.env peer-authenticated runtime URLs. 
DATABASE_URL="postgresql://user:CHANGEME@localhost:5432/oralhistarchiv"

# Max connections in the per-process psycopg pool (1-50).
DATABASE_POOL_SIZE=5

# Maximum requests allowed to wait for a connection from each process's
# psycopg pool (1-1000). Keep this finite so database saturation fails quickly
# instead of accumulating an unbounded queue of application requests.
DATABASE_POOL_MAX_WAITING=32

# PostgreSQL statement_timeout applied to pool connections.
# String format: '5s', '500ms', '2min' — or '0' to disable.
DB_STATEMENT_TIMEOUT="5s"
SCHEDULER_STATEMENT_TIMEOUT="5min"

# Initial admin account — only used on first startup when no admin exists.
# Remove or leave blank after the first admin is created.
ADMIN_SEED_EMAIL=admin@example.uzh.ch
ADMIN_SEED_PASSWORD=change-me-immediately-use-a-strong-password

# -----------------------------------------------------------------------------
# Email (SMTP) Configuration
# -----------------------------------------------------------------------------

# Terminal email retention (days); active pending/sending rows are never purged.
OUTBOX_SENT_RETENTION_DAYS=7
OUTBOX_DEAD_RETENTION_DAYS=30
# Maximum rows per terminal status per retention pass (1..5000).
OUTBOX_RETENTION_BATCH_SIZE=1000
# Retention pass interval in seconds (1..60).
OUTBOX_RETENTION_INTERVAL_SECONDS=60
# Warn in /health/detail when pending or sending email reaches this age.
OUTBOX_STALE_AFTER_SECONDS=600

# Complete development messages are written here when SMTP is disabled,
# independently of LOG_LEVEL.
DEV_MAILBOX_DIR=".dev-mailbox"

# Email (SMTP) — required in staging and production for transactional mail
# Disabled by default. Set SMTP_ENABLED=true when SMTP is configured.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP AUTH is optional. Set BOTH or NEITHER — an empty SMTP_PASSWORD= counts
# as "set" (SecretStr rather than None); without a user it fails pair validation.
# With a user, an empty password passes that check. The placeholder pair is
# ignored while SMTP_ENABLED=false. When enabling SMTP: replace both with real
# credentials, or DELETE both lines if your relay needs no AUTH.
SMTP_USER="replace-me-smtp-user"
SMTP_PASSWORD="REPLACE-ME-SMTP-PASSWORD"
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Oral History Archive
SMTP_USE_TLS=true

# PEM CA bundle for verifying the SMTP relay's certificate — set this for an
# internal relay signed by a private CA. Empty = use the system trust store.
SMTP_CA_BUNDLE=""


# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# When SMTP is disabled in development, complete messages are saved under
# DEV_MAILBOX_DIR independently of LOG_LEVEL. Normal logs redact action links.
LOG_LEVEL="DEBUG"

# Log format: json or text
LOG_FORMAT="json"

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------

# Generate independent values: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY signs action links and derives audit/limiter HMAC keys.
# SESSION_SECRET signs session IDs and CSRF HMACs. The JSON key rings encrypt
# TOTP secrets and outbox bodies respectively: first encrypts, all decrypt.
# Follow docs/runbooks/key-rotation.md before removing a key.
SECRET_KEY="INSECURE-DEV-KEY-CHANGE-IN-PRODUCTION"
TOTP_ENCRYPTION_KEYS=["INSECURE-DEV-TOTP-KEY-CHANGE-IN-PRODUCTION"]
OUTBOX_ENCRYPTION_KEYS=["INSECURE-DEV-OUTBOX-KEY-CHANGE-IN-PRODUCTION"]
SESSION_SECRET="INSECURE-SESSION-SECRET-CHANGE-IN-PRODUCTION"

# Issuer label shown in authenticator apps during TOTP enrollment.
TOTP_ISSUER_NAME="Oral History Archive UZH"

# Account lockout: consecutive failed logins before lockout, and lockout
# duration in minutes.
LOGIN_FAILURE_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# Durable submission budgets for authenticated credential step-ups and staged
# authenticator-rotation confirmation (1-100). The first budget is shared by
# every sensitive step-up performed with the same full session.
SESSION_STEP_UP_ATTEMPT_LIMIT=5
TOTP_ROTATION_CONFIRMATION_ATTEMPT_LIMIT=5

# The scheduler deletes unverified local accounts older than this many days.
UNVERIFIED_REAP_AFTER_DAYS=7


# Required outside development: staging and production reject startup when
# this is unset. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTH_DETAIL_TOKEN="INSECURE-DEV-HEALTH-TOKEN-CHANGE-IN-PRODUCTION"

# Cookie settings. This is the dev file, so false; the hardened-env validator
# refuses false in staging/production, where it must be true. (Set false in dev
# because plain-HTTP non-browser clients — curl, httpx — drop Secure cookies.)
COOKIES_SECURE=false

# Session cookie name, and absolute session lifetime in seconds counted from
# creation (also the signed-cookie max age). 28800 = 8 hours.
SESSION_COOKIE_NAME="oha_session"
SESSION_MAX_AGE_SECONDS=28800

# Enable/disable API rate limiting. Staging and production refuse to start
# when this is false; disabling it is supported only for local development.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Dedicated Redis credential for security rate-limit counters. The hardened
# web process requires and functionally probes this at startup; the scheduler
# intentionally does not receive it. Use a separately capacity-managed Redis
# process on a different host/port or Unix socket from REDIS_URL; credentials
# or database numbers on the same process are not isolation. Supported schemes
# are redis://, rediss://, and redis+unix://. In dev only, an empty value falls
# back to REDIS_URL when REDIS_ENABLED=true, then to process-local memory when
# general Redis is off. Query parameters are forbidden in both Redis URLs
# because redis-py lets them override reviewed connection and TLS options.
# When set in staging/production, use a non-default ACL username and an
# independent password generated with secrets.token_urlsafe(64). Plain
# redis:// is accepted only on loopback; use rediss:// remotely. The dedicated
# limiter must use database 0 (empty path or /0; Unix sockets default to DB 0).
RATE_LIMIT_REDIS_URL=""


# Trust the X-Forwarded-For header from the reverse proxy (nginx) so rate
# limiting keys on the real client IP, not the proxy's. REQUIRED true in
# production behind nginx — validate_security_settings blocks startup if false.
RATE_LIMIT_TRUST_PROXY=true

# Upstream proxies whose X-Real-IP / X-Forwarded-For are honoured when
# RATE_LIMIT_TRUST_PROXY=true and the app is reached over TCP. JSON list.
# (Requests arriving via the gunicorn Unix socket are trusted implicitly.)
TRUSTED_PROXY_IPS=["127.0.0.1", "::1"]

# CORS allowed origins
CORS_ENABLED=true
CORS_ORIGINS=["http://localhost:5000", "http://127.0.0.1:5000"]

# CORS method/header allow-lists and the credentials flag. Wildcards combined
# with CORS_ALLOW_CREDENTIALS=true are rejected at startup in staging/prod.
CORS_ALLOW_METHODS=["GET", "POST"]
CORS_ALLOW_HEADERS=["Authorization", "Content-Type"]
CORS_ALLOW_CREDENTIALS=false

# Trusted Host header values. Must include every hostname
# the app is served under (no scheme, no port). Used by TrustedHostMiddleware.
# Replace "localhost", "127.0.0.1" in staging and prod.
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Source A metadata visibility: public, registered or vetted. Every ingested
# Source A record receives this tier; access_level remains a separate label.
SWISSUBASE_MAX_VISIBILITY="public" 

# Maximum simultaneous password operations per worker; allowed values: 1–2.
PASSWORD_WORK_CONCURRENCY=1

# Set false to disable new local sign-ups; existing users can still sign in.
LOCAL_REGISTRATION_ENABLED=true

# -----------------------------------------------------------------------------
# Redis (optional cross-worker cache invalidation/pub-sub)
# -----------------------------------------------------------------------------

# This general Redis connection is optional in every environment and is not
# used as the hardened limiter. Without pub/sub, the catalogue-statistics
# cache relies on its one-hour TTL; facets are queried live.
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"


# -----------------------------------------------------------------------------
# Shibboleth / SWITCH edu-ID (federated login)
# -----------------------------------------------------------------------------

# Shibboleth is OPTIONAL. Disabled by default. When enabled, the nginx SP layer 
# (shibd + FastCGI via the nginx-http-shibboleth module — see Deployment.md §9) 
# authenticates at the IdP and forwards attributes as request headers; the app 
# trusts them ONLY on the callback path, gated by SHIBBOLETH_INTERNAL_SECRET.
SHIBBOLETH_ENABLED=false

# REQUIRED when SHIBBOLETH_ENABLED=true. nginx must inject this on the callback
# path so the app can verify the request came from nginx, not a direct client.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHIBBOLETH_INTERNAL_SECRET="INSECURE-SHIB-DEV-SECRET-CHANGE-IN-PRODUCTION"

# Exact HTTPS IdP entity IDs as JSON; nonempty when federation is enabled.
# No duplicates/wildcards; issuer matching is case-sensitive and not by email.
SHIBBOLETH_TRUSTED_ISSUERS='["https://eduid.ch/idp/shibboleth"]'
