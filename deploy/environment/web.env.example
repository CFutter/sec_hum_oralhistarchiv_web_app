# Install as /etc/oralhistarchiv/web.env, root:root 0600; loaded after common.env.
APP_PROCESS_ROLE=web
# Generate independently; the scheduler must never receive this key ring.
TOTP_ENCRYPTION_KEYS='["GENERATE_INDEPENDENT_TOKEN_URLSAFE_64"]'
# DATABASE_URL selects the web runtime role over the percent-encoded local
# Unix-socket path; provision its peer mapping and reviewed grants.
# RATE_LIMIT_REDIS_URL must be a dedicated authenticated redis:// or rediss://
# URL in staging/production; replace the empty placeholder before startup.
# Use database 0 for the shipped security Redis (databases 1); keep monitor
# credentials out of this file. See Deployment.md for ACL provisioning.
DATABASE_URL="postgresql:///oralhistarchiv?host=%2Fvar%2Frun%2Fpostgresql&user=oralhistarchiv_web"
RATE_LIMIT_REDIS_URL=""

# Shared Redis allocation cap and mandatory search-start budget.
LIMITER_COUNTER_CAPACITY=20000
LIMITER_CLEANUP_BATCH_SIZE=128
SEARCH_GLOBAL_RATE_PER_SECOND=0.5
SEARCH_GLOBAL_BURST=1
# One additional search connection per worker; one search transaction across
# workers. Keep these budgets below the whole-operation deadline.
SEARCH_STATEMENT_TIMEOUT_MS=500
SEARCH_OPERATION_TIMEOUT_SECONDS=1.0
SEARCH_POOL_TIMEOUT_SECONDS=0.1

# Read only the nonsecret timestamp marker, never backup archives or private keys.
# The backup config's BACKUP_STATUS_DIR must refer to its containing directory.
BACKUP_STATUS_FILE="/var/lib/oralhistarchiv-backup-status/last-success"

# Ordered JSON rules propose tiers from trusted assertions for administrator
# review; they never grant access. See docs/architecture/federated-tier-rules.md.
FEDERATED_TIER_RULES='[]'
