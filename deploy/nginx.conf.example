# /etc/nginx/sites-available/oralhistarchiv
#
# Example nginx config for the Digital Oral History Archive.
# Copy to /etc/nginx/sites-available/ and symlink from sites-enabled/.
# Replace placeholders marked with <> before deploying.
#
# Required edits:
#   - server_name:                your domain
#   - ssl_certificate paths:      your TLS cert and key
#
# Required companion file:
#   - Copy nginx-ordinary-proxy-headers.conf.example to
#     /etc/nginx/snippets/oralhistarchiv-ordinary-proxy-headers.conf.
#
# Site-specific configuration. See also /etc/nginx/nginx.conf for
# global hardening directives:
#   - server_tokens off
#   - client_body_timeout 10s
#   - client_header_timeout 10s
#   - send_timeout 10s

# Defined at http context: this file is included from nginx.conf's http block.
# Deliberately excludes URI, query arguments, Referer, and arbitrary headers.
log_format oralhistarchiv_safe escape=json
    '{"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"status":$status,'
    '"bytes_sent":$body_bytes_sent,'
    '"request_time":"$request_time",'
    '"request_id":"$sent_http_x_request_id"}';

upstream oralhistarchiv {
    server unix:/run/oralhistarchiv/gunicorn.sock;
}

# Coarse per-client edge backstop, independent of the application's own
# per-route limiter. Slow or incomplete clients are handled by the
# client_*_timeout directives in nginx.conf, not by these limits.
# Tune rate/burst to real traffic before relying on them.
limit_req_zone  $binary_remote_addr zone=oralhistarchiv_req:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=oralhistarchiv_conn:10m;

# Separate, small budget for /health so monitoring behind a shared NAT
# address never competes with ordinary traffic from that address.
limit_req_zone  $binary_remote_addr zone=oralhistarchiv_health_req:1m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=oralhistarchiv_health_conn:1m;

limit_req_status  429;
limit_conn_status 429;

# Redirect plain HTTP to HTTPS
# --- Default reject for unknown Host headers ---
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log /var/log/nginx/oralhistarchiv_access.log oralhistarchiv_safe;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name <archive.example.uzh.ch>;
    access_log /var/log/nginx/oralhistarchiv_access.log oralhistarchiv_safe;
    return 301 https://$server_name$request_uri;
}

# --- Default reject for unknown Host headers ---
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;
    access_log /var/log/nginx/oralhistarchiv_access.log oralhistarchiv_safe;

    # Need a cert because TLS handshake completes before nginx sees the Host
    ssl_certificate     /etc/ssl/certs/<archive.example.uzh.ch>.pem;
    ssl_certificate_key /etc/ssl/private/<archive.example.uzh.ch>.key;

    return 444;  # nginx-specific: close connection without HTTP response
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <archive.example.uzh.ch>;
    access_log /var/log/nginx/oralhistarchiv_access.log oralhistarchiv_safe;

    # --- TLS ---
    ssl_certificate     /etc/ssl/certs/<archive.example.uzh.ch>.pem;
    ssl_certificate_key /etc/ssl/private/<archive.example.uzh.ch>.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Cover edge responses too; review every subdomain before enabling preload.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # --- Request size limits ---
    # The app has no file uploads, so keep request bodies small.
    client_max_body_size 64k;

    # --- Static assets ---
    # Served directly by nginx instead of proxying to gunicorn.
    # Adjust the alias to match your deployment path.
    location /static/ {
        alias /opt/oralhistarchiv/src/app/static/;
        expires off;
        add_header Cache-Control "public, no-cache";
    }

    # --- Optional hardening: IP-restrict /health/detail ------------------
    # Extra layer on top of the app's bearer-token check. Uncomment and set
    # your monitoring range(s). Leave commented if you have no stable
    # internal range — the bearer token (404 on failure) still protects it.
    # This sibling block has no rate/connection limits; add reviewed limits
    # before enabling it. It does not inherit limits from location /.
    #location = /health/detail {
    #    allow 10.0.0.0/8;      # your monitoring range
    #    deny  all;
    #    proxy_pass http://oralhistarchiv;
    #    include /etc/nginx/snippets/oralhistarchiv-ordinary-proxy-headers.conf;
    #}

    # --- Shibboleth callback — Phase 1 fail-closed gate ---
    # Replace this entire block with the complete SP-authorized proxy block
    # from Deployment.md only after shibd, the FastCGI authorizer, attribute
    # mapping, and SHIBBOLETH_INTERNAL_SECRET have been verified. Keeping the
    # callback closed prevents an application flag flip from trusting
    # client-supplied identity headers before the SP exists.
    location = /auth/shibboleth/callback {
        return 404;
    }

    # --- Main application ---
    location / {
        proxy_pass http://oralhistarchiv;
        # Load-bearing header hygiene. This include forwards ordinary request
        # metadata but clears every application-facing federation header. It
        # must be present in every location that proxies an untrusted request
        # to the application.
        include /etc/nginx/snippets/oralhistarchiv-ordinary-proxy-headers.conf;

        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;

        limit_req  zone=oralhistarchiv_req burst=40 nodelay;
        limit_conn oralhistarchiv_conn 20;
    }

    # --- Health check for external monitoring ---
    # Public, no auth. The app exempts /health from its own limiter,
    # so the edge limit below is its only admission control.
    location = /health {
            proxy_pass http://oralhistarchiv;
            include /etc/nginx/snippets/oralhistarchiv-ordinary-proxy-headers.conf;
            access_log off;

            limit_req  zone=oralhistarchiv_health_req burst=10 nodelay;
            limit_conn oralhistarchiv_health_conn 5;
        }
}
