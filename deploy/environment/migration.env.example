# Install as /etc/oralhistarchiv/migration.env, root:root 0600.
# Production-only oneshot; this file is not loaded by web/scheduler units.
# ENV_STATE is checked by ExecStartPre. MIGRATION_DATABASE_URL is Alembic's
# owner connection (percent-encoded Unix-socket path). PGHOST/PGUSER select the
# owner/socket for psql grant commands. Provision the matching peer mapping.
ENV_STATE=production
MIGRATION_DATABASE_URL="postgresql:///oralhistarchiv?host=%2Fvar%2Frun%2Fpostgresql&user=oralhistarchiv"
PGHOST=/var/run/postgresql
PGUSER=oralhistarchiv
