# /etc/systemd/system/oralhistarchiv.service
#
# Systemd service unit for the Oral History Archive.
#
# Install:
#   sudo cp oralhistarchiv.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable oralhistarchiv
#   sudo systemctl start oralhistarchiv
#
# Logs:
#   sudo journalctl -u oralhistarchiv -f

[Unit]
Description=Oral History Archive (Gunicorn/Uvicorn)
# The reference deployment adds a web-only Requires/After drop-in for its
# local dedicated limiter. Keeping that host-specific dependency outside this
# base unit preserves support for an institutionally managed external endpoint.
# Hardened web startup still functionally probes RATE_LIMIT_REDIS_URL.
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5


[Service]
# The service user owns the socket; the primary group is shared only with the
# dedicated nginx worker identity. Do not add interactive users or unrelated
# services to oralhistarchiv-proxy.
User=oralhistarchiv
Group=oralhistarchiv-proxy
UMask=0077

# /opt/oralhistarchiv is a root-managed symlink created by install_release.py.
WorkingDirectory=/opt/oralhistarchiv

# systemd's root manager reads common.env, web.env, and optional shibboleth.env.
# Each must be root:root 0600 in root-controlled /etc/oralhistarchiv.
# Import application code only from the installed wheel in this release's venv,
# and never expose the monitor-only Redis credential to the web process.
UnsetEnvironment=PYTHONPATH PYTHONHOME VIRTUAL_ENV RATE_LIMIT_MONITOR_REDIS_URL

# systemd owns the parent directory boundary; Gunicorn's `umask = 0o117`
# independently produces a 0660 socket inode.
RuntimeDirectory=oralhistarchiv
RuntimeDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oralhistarchiv


EnvironmentFile=/etc/oralhistarchiv/common.env
EnvironmentFile=/etc/oralhistarchiv/web.env
EnvironmentFile=-/etc/oralhistarchiv/shibboleth.env
ExecStartPre=/usr/bin/test ${ENV_STATE} = production
ExecStart=/usr/bin/flock --shared --no-fork /run/lock/oralhistarchiv-deploy.lock /opt/oralhistarchiv/.venv/bin/python -I -m gunicorn -c /opt/oralhistarchiv/gunicorn.conf.py app.main:app

Restart=on-failure
RestartSec=5

MemoryMax=1024M

# File descriptor limit (connections + file handles)
LimitNOFILE=4096

ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/oralhistarchiv

NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Permit Unix/TCP address families; this does not restrict destination hosts.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
