# /etc/rsyslog.d/30-oralhistarchiv.conf  (example — copy and edit before use)
#
# Forward stdout/stderr journal records from the four selected service units.
#
# MODEL: The application does NOT ship logs itself. It writes structured
# JSON to stdout, which systemd-journald captures. This rsyslog config
# reads from journald and forwards to a central collector over RELP+TLS
# (reliable, encrypted, mutually authenticated). See Deployment.md §12.
#
#
# Replace every <...> placeholder before deploying.

# ---------------------------------------------------------------------------
# 1. Read from the systemd journal
# ---------------------------------------------------------------------------
module(load="imjournal"
       StateFile="imjournal-oralhistarchiv.state"
       Ratelimit.Interval="0")   # Disable imjournal input rate limiting.

# Avoid silent truncation of long audit records (events with stack traces can
# exceed the 8 KiB default and would otherwise be cut mid-JSON).
# NOTE: $MaxMessageSize is a global — for full effect set it at the very top
# of /etc/rsyslog.conf; placed in a drop-in it only affects config parsed
# after this file.
$MaxMessageSize 64k

# ---------------------------------------------------------------------------
# 2. Forward over RELP + TLS to the central collector
# ---------------------------------------------------------------------------
# RELP acknowledges delivery; queue/storage failures can still lose records.
# TLS verifies the collector against caCert/permittedPeer and presents myCert
# with myPrivKey. Provision certificates and validate peer names before enabling.
module(load="omrelp")

# Forward the four application units selected by journald's trusted unit
# metadata. Do not select on $programname/$syslogtag: an ordinary local
# process can choose those values, and executable-derived names can drift.
if (($!_SYSTEMD_UNIT == "oralhistarchiv.service")
    or ($!_SYSTEMD_UNIT == "oralhistarchiv-scheduler.service")
    or ($!_SYSTEMD_UNIT == "oralhistarchiv-backup.service")
    or ($!_SYSTEMD_UNIT == "oralhistarchiv-migrate.service")) then {

    action(
        name="oralhistarchiv_remote_audit"
        type="omrelp"
        target="<logcollector.uzh.ch>"
        port="<2514>"

        tls="on"
        tls.caCert="/etc/rsyslog.d/tls/ca.pem"
        tls.myCert="/etc/rsyslog.d/tls/oralhistarchiv-client-cert.pem"
        tls.myPrivKey="/etc/rsyslog.d/tls/oralhistarchiv-client-key.pem"
        tls.authMode="name"   # omrelp accepts "name"/"fingerprint"/"certvalid" — NOT the imtcp-style "x509/name"
        tls.permittedPeer=["<logcollector.uzh.ch>"]

        # Disk-assisted queue; retry indefinitely but monitor its 512 MiB disk
        # limit, suspension, and host free space. Exhaustion can block/drop input.
        queue.type="LinkedList"
        queue.filename="relp_oralhistarchiv_fwd"
        queue.maxDiskSpace="512m"
        queue.saveOnShutdown="on"
        action.resumeRetryCount="-1"        # retry forever
        action.resumeInterval="30"          # seconds between retries
        action.reportSuspension="on"
        action.reportSuspensionContinuation="on"      
    )

    # Later rsyslog rules still run; journald retention is independent.
    # stop
}