# Run after stopping web/scheduler and reviewing the installed release. The
# oneshot holds an exclusive deployment flock and waits for shared holders;
# unlike installer acquisition, it is not nonblocking. It loads only migration.env
# and requires ENV_STATE=production. See Deployment.md for grants/verification.
[Unit]
Description=Oral History Archive — reviewed database migration
Requires=postgresql.service
After=postgresql.service
Conflicts=oralhistarchiv.service oralhistarchiv-scheduler.service
Before=oralhistarchiv.service oralhistarchiv-scheduler.service

[Service]
Type=oneshot
User=oralhistarchiv-migrate
Group=oralhistarchiv-migrate
UMask=0077
WorkingDirectory=/opt/oralhistarchiv
EnvironmentFile=/etc/oralhistarchiv/migration.env
ExecStartPre=/usr/bin/test ${ENV_STATE} = production
UnsetEnvironment=PYTHONPATH PYTHONHOME VIRTUAL_ENV RATE_LIMIT_REDIS_URL RATE_LIMIT_MONITOR_REDIS_URL
ExecStart=/usr/bin/flock --exclusive --no-fork /run/lock/oralhistarchiv-deploy.lock /opt/oralhistarchiv/.venv/bin/python -I /opt/oralhistarchiv/deploy/migrate_release.py
SyslogIdentifier=oralhistarchiv-migrate
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
