# Install as /etc/oralhistarchiv/scheduler.env, root:root 0600. Loaded after
# common.env, this overrides DATABASE_URL with the scheduler role over the
# percent-encoded local Unix-socket path. Provision its peer mapping/grants.
# Do not put the web-only limiter or federation callback credentials here.
DATABASE_URL="postgresql:///oralhistarchiv?host=%2Fvar%2Frun%2Fpostgresql&user=oralhistarchiv_scheduler"