# /etc/nginx/snippets/oralhistarchiv-shibboleth-secret.conf
#
# Phase 2 only. Copy to the path above as root, replace the placeholder with an
# independently generated value, and set owner root:root and mode 0600. Never
# place the live value in the repository, the ordinary site file, shell history,
# tickets, or captured `nginx -T` output.

proxy_set_header X-OHA-Internal-Auth "<generate-a-unique-high-entropy-secret>";
