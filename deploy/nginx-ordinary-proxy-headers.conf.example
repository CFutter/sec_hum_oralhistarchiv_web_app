# /etc/nginx/snippets/oralhistarchiv-ordinary-proxy-headers.conf
#
# Include this file in EVERY nginx location that proxies an ordinary,
# client-originated request to the application. Do not include it in the
# SP-authorized Shibboleth callback: that location disables forwarding of all
# client headers and supplies its own trusted federation headers.

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;

# Current, fixed application-facing trust contract.
proxy_set_header X-OHA-Internal-Auth      "";
proxy_set_header X-OHA-Shib-Issuer        "";
proxy_set_header X-OHA-Shib-Subject       "";
proxy_set_header X-OHA-Shib-Mail          "";
proxy_set_header X-OHA-Shib-Authn-Context "";
proxy_set_header X-OHA-Shib-Display-Name  "";
proxy_set_header X-OHA-Shib-Affiliation   "";
proxy_set_header X-OHA-Shib-Country       "";

# Legacy/raw names are cleared as defense in depth and during upgrades. The
# application must never consume them directly.
proxy_set_header X-Internal-Auth              "";
proxy_set_header REMOTE_USER                  "";
proxy_set_header eduPersonUniqueId            "";
proxy_set_header mail                         "";
proxy_set_header displayName                  "";
proxy_set_header affiliation                  "";
proxy_set_header schacHomeOrganizationCountry "";
proxy_set_header Shib-Identity-Provider       "";
proxy_set_header Shib-AuthnContext-Class      "";