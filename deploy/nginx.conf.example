# /etc/nginx/sites-available/oralhistarchiv
#
# Example nginx config for the Digital Oral History Archive.
# Copy to /etc/nginx/sites-available/ and symlink from sites-enabled/.
# Replace placeholders marked with <> before deploying.
#
# Required edits:
#   - server_name:                your domain
#   - ssl_certificate paths:      your TLS cert and key
#   - X-Internal-Auth value:      must match SHIBBOLETH_INTERNAL_SECRET in .env
#
# Site-specific configuration. See also /etc/nginx/nginx.conf for
# global hardening directives:
#   - server_tokens off
#   - client_body_timeout 10s
#   - client_header_timeout 10s
#   - send_timeout 10s
    

upstream oralhistarchiv {
    server unix:/run/oralhistarchiv/gunicorn.sock;
}

# Redirect plain HTTP to HTTPS
# --- Default reject for unknown Host headers ---
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name <archive.example.uzh.ch>;
    return 301 https://$server_name$request_uri;
}

# --- Default reject for unknown Host headers ---
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    # Need a cert because TLS handshake completes before nginx sees the Host
    ssl_certificate     /etc/ssl/certs/<archive.example.uzh.ch>.pem;
    ssl_certificate_key /etc/ssl/private/<archive.example.uzh.ch>.key;

    return 444;  # nginx-specific: close connection without HTTP response
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <archive.example.uzh.ch>;

    # --- TLS ---
    ssl_certificate     /etc/ssl/certs/<archive.example.uzh.ch>.pem;
    ssl_certificate_key /etc/ssl/private/<archive.example.uzh.ch>.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS is also sent by the app (see security_headers.py), but nginx
    # as the first hop can set it too — no harm in both.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # --- Request size limits ---
    # The app has no file uploads, so keep request bodies small.
    client_max_body_size 64k;

    # --- Static assets ---
    # Served directly by nginx instead of proxying to gunicorn.
    # Adjust the alias to match your deployment path.
    location /static/ {
        alias /opt/oralhistarchiv/src/app/static/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # --- Optional hardening: IP-restrict /health/detail ------------------
    # Extra layer on top of the app's bearer-token check. Uncomment and set
    # your monitoring range(s). Leave commented if you have no stable
    # internal range — the bearer token (404 on failure) still protects it.
    #location = /health/detail {
    #    allow 10.0.0.0/8;      # your monitoring range
    #    deny  all;
    #    proxy_pass http://oralhistarchiv;
    #    proxy_set_header Host      $host;
    #    proxy_set_header X-Real-IP $remote_addr;
    #}

    # --- Shibboleth callback — defense-in-depth secret header ---
    # Kept above `location /` for readability. Correctness does NOT depend
    # on file order: the `=` exact-match has priority over prefix locations
    # wherever it appears. What IS load-bearing is the header hygiene —
    # this is the only location that may set X-Internal-Auth and the
    # Shibboleth attribute headers, and `location /` below must keep
    # clearing them.
    #
    # The X-Internal-Auth value must match SHIBBOLETH_INTERNAL_SECRET
    # in /opt/oralhistarchiv/.env exactly. Generate with:
    #   python -c 'import secrets; print(secrets.token_urlsafe(32))'
    location = /auth/shibboleth/callback {
        proxy_pass http://oralhistarchiv;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Defense-in-depth: paired with settings.shibboleth_internal_secret
        proxy_set_header X-Internal-Auth "<paste-SHIBBOLETH_INTERNAL_SECRET-here>";

        # --- Phase 2 (Shibboleth SP) — commented out on purpose -------------
        # The $shib_* variables below only exist once the third-party
        # nginx-http-shibboleth module is loaded and shib_request_set
        # directives populate them (see Deployment.md §9). Active but
        # unwired, they make `nginx -t` fail with:
        #   unknown "shib_remote_user" variable
        # Leave them commented for a Phase-1 deployment; uncomment only
        # after the SP layer (shibd + FastCGI authorizer) is in place.
        #proxy_set_header REMOTE_USER       $shib_remote_user;
        #proxy_set_header mail              $shib_mail;
        #proxy_set_header displayName       $shib_display_name;
        #proxy_set_header affiliation       $shib_affiliation;
        # Country attribute: the app's code default header name is
        # schacHomeOrganizationCountry, but .env.example overrides it to
        # "country" — pick ONE name, forward it here, and strip the SAME
        # name in `location /` below.
        #proxy_set_header schacHomeOrganizationCountry $shib_country;
    }

    # --- Main application ---
    location / {
        proxy_pass http://oralhistarchiv;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Strip any client-supplied X-Internal-Auth so it can only be set
        # by the Shibboleth callback location above.
        proxy_set_header X-Internal-Auth "";
        proxy_set_header REMOTE_USER "";
        proxy_set_header mail "";
        proxy_set_header displayName "";
        proxy_set_header affiliation "";
        proxy_set_header schacHomeOrganizationCountry "";

        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;
    }

    # --- Health check for external monitoring ---
    # Public endpoint, no auth, no rate limiting upstream.
    location = /health {
        proxy_pass http://oralhistarchiv;
        access_log off;
    }
}